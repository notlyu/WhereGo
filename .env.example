# Скопируй в .env.local и подставь значения из дашборда Supabase:
#   Project Settings → API
#
# Пока переменных нет, приложение работает на локальных демо-данных
# (localStorage) — экраны можно открыть и проверить без бэкенда.
#
# Б-1: сюда попадает ТОЛЬКО anon key. Service role ключ даёт полный обход RLS,
# а всё, что здесь, уезжает в бандл и читается любым посетителем.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
